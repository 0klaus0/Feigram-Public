#!/bin/bash

APP_HOME="${TRIM_APPDEST}"
NODE_BIN="${APP_HOME}/bin/node"
SERVER_DIR="${APP_HOME}/server"
DATA_HOME="/${TRIM_APPDEST_VOL}/@appshare/feigrampub"
PID_FILE="${DATA_HOME}/feigram.pid"
VERSION_FILE="${DATA_HOME}/feigram.version"
LOG_FILE="${DATA_HOME}/feigram.log"
PORT="${wizard_app_port:-3088}"

export APP_PORT="$PORT"
export FEIGRAM_APP_URL="http://127.0.0.1:${PORT}"
export APP_PASSWORD="${wizard_app_password}"
export PUBLIC_BASE_URL="${wizard_public_base_url:-http://127.0.0.1:${PORT}}"
export TELEGRAM_API_ID="${wizard_telegram_api_id}"
export TELEGRAM_API_HASH="${wizard_telegram_api_hash}"
export DATA_DIR="${DATA_HOME}/data"
export DOWNLOAD_DIR="${DATA_HOME}/data/downloads"
export LOG_FILE="$LOG_FILE"
export APP_EDITION="Fngram 2.0 fnOS Client Edition"
export APP_VERSION="2.0.46"
export APP_CHANGELOG="給所有 GramJS 調用添加超時保護，簡化連接斷開處理避免 getStreamChannels 卡住，新增僵死檢測自動停止卡住的 relay。"
export NODE_ENV="production"
export TELEGRAM_TRANSPORT="${TELEGRAM_TRANSPORT:-obfuscated}"

is_running() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE")"
        if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

stop_running() {
    if is_running; then
        pid="$(cat "$PID_FILE")"
        kill "$pid" >/dev/null 2>&1 || true
        for _ in 1 2 3 4 5; do
            if ! kill -0 "$pid" >/dev/null 2>&1; then
                break
            fi
            sleep 1
        done
        if kill -0 "$pid" >/dev/null 2>&1; then
            kill -9 "$pid" >/dev/null 2>&1 || true
        fi
    fi
    rm -f "$PID_FILE"
    if command -v pgrep >/dev/null 2>&1; then
        pattern="${APP_HOME}/bin/node.*src/index.js|${SERVER_DIR}/src/index.js"
        for old_pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill "$old_pid" >/dev/null 2>&1 || true
            fi
        done
        sleep 1
        for old_pid in $(pgrep -f "$pattern" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill -9 "$old_pid" >/dev/null 2>&1 || true
            fi
        done
        # Stop a downloader left by pre-2.0.70 packages during the upgrade.
        for old_pid in $(pgrep -f "feigram-downloader" 2>/dev/null || true); do
            if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ]; then
                kill "$old_pid" >/dev/null 2>&1 || true
            fi
        done
    fi
}

case "$1" in
start)
    mkdir -p "$DATA_HOME" "$DATA_DIR" "$DOWNLOAD_DIR"
    chmod +x "$NODE_BIN"
    if is_running; then
        running_version=""
        if [ -f "$VERSION_FILE" ]; then
            running_version="$(cat "$VERSION_FILE")"
        fi
        if [ "$running_version" = "$APP_VERSION" ]; then
            exit 0
        fi
        {
            echo "==== $(date '+%Y-%m-%d %H:%M:%S') Fngram upgrade restart ===="
            echo "From: ${running_version:-unknown}"
            echo "To: ${APP_VERSION}"
        } >> "$LOG_FILE"
        stop_running
    fi
    cd "$SERVER_DIR" || exit 1
    {
        echo "==== $(date '+%Y-%m-%d %H:%M:%S') Fngram start ===="
        echo "Edition: ${APP_EDITION}"
        echo "Version: ${APP_VERSION}"
        echo "Port: ${APP_PORT}"
        echo "Data: ${DATA_DIR}"
        echo "Downloads: ${DOWNLOAD_DIR}"
        echo "Download engine: Telegram/GramJS"
    } >> "$LOG_FILE"
    nohup "$NODE_BIN" src/index.js >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 2
    if is_running; then
        echo "$APP_VERSION" > "$VERSION_FILE"
        exit 0
    fi
    tail -80 "$LOG_FILE"
    exit 1
    ;;
stop)
    stop_running
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
