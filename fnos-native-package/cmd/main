#!/bin/bash

APP_HOME="${TRIM_APPDEST}"
NODE_BIN="${APP_HOME}/bin/node"
SERVER_DIR="${APP_HOME}/server"
DATA_HOME="/${TRIM_APPDEST_VOL}/@appshare/feigrampub"
PID_FILE="${DATA_HOME}/feigram.pid"
LOG_FILE="${DATA_HOME}/feigram.log"
PORT="${wizard_app_port:-3088}"

export APP_PORT="$PORT"
export APP_PASSWORD="${wizard_app_password}"
export PUBLIC_BASE_URL="${wizard_public_base_url:-http://127.0.0.1:${PORT}}"
export TELEGRAM_API_ID="${wizard_telegram_api_id}"
export TELEGRAM_API_HASH="${wizard_telegram_api_hash}"
export DATA_DIR="${DATA_HOME}/data"
export DOWNLOAD_DIR="${DATA_HOME}/data/downloads"
export LOG_FILE="$LOG_FILE"
export APP_EDITION="Feigram 2.0 fnOS Client Edition"
export APP_VERSION="2.0.22"
export APP_CHANGELOG="修复后台缓存 iterDownload 文档定位类型错误。"
export NODE_ENV="production"

is_running() {
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE")"
        if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

case "$1" in
start)
    mkdir -p "$DATA_HOME" "$DATA_DIR" "$DOWNLOAD_DIR"
    chmod +x "$NODE_BIN"
    if is_running; then
        exit 0
    fi
    cd "$SERVER_DIR" || exit 1
    {
        echo "==== $(date '+%Y-%m-%d %H:%M:%S') Feigram start ===="
        echo "Edition: ${APP_EDITION}"
        echo "Version: ${APP_VERSION}"
        echo "Port: ${APP_PORT}"
        echo "Data: ${DATA_DIR}"
        echo "Downloads: ${DOWNLOAD_DIR}"
    } >> "$LOG_FILE"
    nohup "$NODE_BIN" src/index.js >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 2
    if is_running; then
        exit 0
    fi
    tail -80 "$LOG_FILE"
    exit 1
    ;;
stop)
    if is_running; then
        kill "$(cat "$PID_FILE")" >/dev/null 2>&1 || true
        rm -f "$PID_FILE"
    fi
    exit 0
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
